<%# Constructor created from modal %>
<%= turbo_stream.append "habitation_constructor_id" do %>
  <option value="<%= @constructor.id %>" selected><%= @constructor.name %></option>
<% end %>

<%= turbo_stream.append "constructor_id_select_in_development_form" do %>
  <option value="<%= @constructor.id %>"><%= @constructor.name %></option>
<% end if defined?(@constructor) %>

<script>
  // Close modal and trigger TomSelect update if applicable
  const modalEl = document.getElementById('quickAddConstructorModal');
  if (modalEl) {
    const modal = bootstrap.Modal.getInstance(modalEl);
    if (modal) modal.hide();
  }
  
  // Update select value manually if TomSelect is used
  const select = document.getElementById('habitation_constructor_id');
  if (select && select.tomselect) {
    select.tomselect.addOption({value: '<%= @constructor.id %>', text: '<%= j @constructor.name %>'});
    select.tomselect.addItem('<%= @constructor.id %>');
  } else if (select) {
    select.value = '<%= @constructor.id %>';
  }
</script>
