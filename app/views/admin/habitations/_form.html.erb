                  <%= f.select :key_location, Habitation::KEY_LOCATION_OPTIONS, { include_blank: "Selecione..." }, class: "form-select form-select-sm" %>
                </div>
                <div class="col-md-6">
                  <%= f.label :key_location_notes, "Detalhe das chaves", class: "form-label small fw-bold mb-1" %>
                  <%= f.text_field :key_location_notes, class: "form-control form-control-sm", placeholder: "Ex: com zelador João" %>
                </div>
                <div class="col-md-12">
                  <%= f.label :observacoes_visitas, "Observações para visitas", class: "form-label small fw-bold mb-1" %>
                  <%= f.text_area :observacoes_visitas, class: "form-control form-control-sm", rows: 2 %>
                </div>
                <div class="col-md-6">
                  <%= f.label :zelador_nome, "Zelador", class: "form-label small fw-bold mb-1" %>
                  <%= f.text_field :zelador_nome, class: "form-control form-control-sm" %>
                </div>
                <div class="col-md-6">
                  <%= f.label :zelador_telefone, "Telefone do zelador", class: "form-label small fw-bold mb-1" %>
                  <%= f.text_field :zelador_telefone, class: "form-control form-control-sm", data: { controller: "mask", mask_type_value: "phone" } %>
                </div>
                <div class="col-md-6">
                  <%= f.label :regiao_foco, "Região foco?", class: "form-label small fw-bold mb-1" %>
                  <%= f.select :regiao_foco, Habitation::REGIAO_FOCO_OPTIONS, { include_blank: "Selecione..." }, class: "form-select form-select-sm", data: { controller: "tom-select", placeholder: "Selecione..." } %>
                </div>
                <div class="col-md-3">
                  <%= f.label :saldo_devedor_formatted, "Saldo devedor", class: "form-label small fw-bold mb-1" %>
                  <div class="input-group input-group-sm">
                    <span class="input-group-text">R$</span>
                    <%= f.text_field :saldo_devedor_formatted, class: "form-control form-control-sm", data: { controller: "mask", mask_type_value: "currency" } %>
                  </div>
                </div>
                <div class="col-md-3">
                  <%= f.label :numero_prestacoes, "Nº de prestações", class: "form-label small fw-bold mb-1" %>
                  <%= f.number_field :numero_prestacoes, class: "form-control form-control-sm", min: 0 %>
                </div>
                <div class="col-md-12">
                  <label class="custom-checkbox-card">
                    <%= f.check_box :aceita_permuta_flag, class: "form-check-input mt-0" %>
                    <span class="small fw-semibold">Aceita permuta</span>
                  </label>
                </div>
              </div>

              <div class="border rounded p-3 mb-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <h6 class="small fw-bold mb-0">Condições de permuta</h6>
                  <span class="badge text-bg-light border">Opcional</span>
                </div>

                <div class="row g-2 mb-2">
                  <div class="col-md-5">
                    <%= f.label :valor_aceito_permuta_formatted, "Valor aceito na permuta", class: "form-label extra-small fw-bold mb-1" %>
                    <div class="input-group input-group-sm">
                      <span class="input-group-text">R$</span>
                      <%= f.text_field :valor_aceito_permuta_formatted, class: "form-control form-control-sm", data: { controller: "mask", mask_type_value: "currency" } %>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <%= f.label :tipo_veiculo_aceito_permuta, "Tipo de veículo aceito", class: "form-label extra-small fw-bold mb-1" %>
                    <%= f.text_field :tipo_veiculo_aceito_permuta, class: "form-control form-control-sm", placeholder: "Ex: SUV, Sedan..." %>
                  </div>
                  <div class="col-md-3">
                    <%= f.label :ano_minimo_veiculo_aceito_permuta, "Ano mínimo do veículo", class: "form-label extra-small fw-bold mb-1" %>
                    <%= f.number_field :ano_minimo_veiculo_aceito_permuta, class: "form-control form-control-sm", min: 1900, max: 2100 %>
                  </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-2">
                  <label class="custom-checkbox-card">
                    <%= f.check_box :aceita_permuta_veiculo_flag, class: "form-check-input mt-0" %>
                    <span class="small fw-semibold">Aceita permuta veículo</span>
                  </label>
                  <label class="custom-checkbox-card">
                    <%= f.check_box :aceita_permuta_imovel_flag, class: "form-check-input mt-0" %>
                    <span class="small fw-semibold">Aceita permuta imóvel</span>
                  </label>
                  <label class="custom-checkbox-card">
                    <%= f.check_box :aceita_permuta_outros_flag, class: "form-check-input mt-0" %>
                    <span class="small fw-semibold">Aceita permuta outros</span>
                  </label>
                </div>

                <div class="small text-muted mb-1 fw-semibold">Características do imóvel aceito na permuta</div>
                <div class="row g-2">
                  <div class="col-md-4">
                    <%= f.label :permuta_valor_formatted, "Valor", class: "form-label extra-small fw-bold mb-1" %>
                    <div class="input-group input-group-sm">
                      <span class="input-group-text">R$</span>
                      <%= f.text_field :permuta_valor_formatted, class: "form-control form-control-sm", data: { controller: "mask", mask_type_value: "currency" } %>
                    </div>
                  </div>
                  <div class="col-md-8">
                    <%= f.label :permuta_localizacao, "Localização", class: "form-label extra-small fw-bold mb-1" %>
                    <%= f.text_field :permuta_localizacao, class: "form-control form-control-sm", placeholder: "Cidade, bairro ou região de interesse" %>
                  </div>
                  <div class="col-md-4">
                    <%= f.label :permuta_dormitorios_qtd, "Dormitórios", class: "form-label extra-small fw-bold mb-1" %>
                    <%= f.number_field :permuta_dormitorios_qtd, class: "form-control form-control-sm", min: 0 %>
                  </div>
                  <div class="col-md-4">
                    <%= f.label :permuta_suites_qtd, "Suítes", class: "form-label extra-small fw-bold mb-1" %>
                    <%= f.number_field :permuta_suites_qtd, class: "form-control form-control-sm", min: 0 %>
                  </div>
                  <div class="col-md-4">
                    <%= f.label :permuta_garagens_qtd, "Garagens", class: "form-label extra-small fw-bold mb-1" %>
                    <%= f.number_field :permuta_garagens_qtd, class: "form-control form-control-sm", min: 0 %>
                  </div>
                </div>
              </div>

              <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="small fw-bold mb-0">Responsáveis & Agenciamento</h6>
                <button type="button" class="btn btn-xs btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addBrokerModal" data-action="habitation-brokers#resetModal">
                  <i class="bi bi-person-plus me-1"></i>Adicionar
                </button>
              </div>

              <div data-habitation-brokers-target="container">
                <%
                  assigned_captador_ids = f.object.broker_assignments
                    .reject(&:marked_for_destruction?)
                    .select { |assignment| assignment.role == "captador" }
                    .map(&:admin_user_id)
                    .compact
                %>
                <% if f.object.admin_user.present? && !assigned_captador_ids.include?(f.object.admin_user_id) %>
                  <div class="card border-dashed p-2 mb-2 bg-light shadow-none">
                    <div class="d-flex justify-content-between align-items-start">
                      <div>
                        <div class="fw-bold extra-small text-primary mb-1">
                          <span class="badge bg-primary extra-small me-1">Captador</span>
                          <%= f.object.admin_user.name %>
                        </div>
                        <div class="text-muted smaller">
                          Captador responsável pelo cadastro do imóvel
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>

                <%= f.fields_for :broker_assignments do |ba_form| %>
                  <div class="nested-fields card border-dashed p-2 mb-2 bg-light shadow-none" data-new-record="<%= ba_form.object.new_record? %>">
                    <%= ba_form.hidden_field :_destroy %>
                    <div class="d-flex justify-content-between align-items-start">
                      <div>
                        <div class="fw-bold extra-small text-primary mb-1">
                          <span class="badge bg-primary extra-small me-1"><%= ba_form.object.role %></span>
                          <%= ba_form.object.admin_user&.name %>
                        </div>
                        <div class="text-muted smaller">
                          <%= ba_form.object.commission_type == 'fixed' ? '$ - Preço' : '% - Porcentagem' %>: <%= ba_form.object.commission_value %>
                        </div>
                      </div>
                      <button type="button" class="btn btn-sm btn-link text-danger p-0" data-action="habitation-brokers#remove">
                        <i class="bi bi-x-circle"></i>
                      </button>
                    </div>
                  </div>
                <% end %>
              </div>

              <!-- Template for NEW records -->
              <template data-habitation-brokers-target="template">
                <div class="nested-fields card border-dashed p-2 mb-2 bg-light shadow-none animate__animated animate__fadeIn" data-new-record="true">
                  <input type="hidden" name="habitation[broker_assignments_attributes][NEW_RECORD][_destroy]" value="0">
                  <input type="hidden" name="habitation[broker_assignments_attributes][NEW_RECORD][role]" value="ROLE_VALUE">
                  <input type="hidden" name="habitation[broker_assignments_attributes][NEW_RECORD][admin_user_id]" value="BROKER_ID_VALUE">
                  <input type="hidden" name="habitation[broker_assignments_attributes][NEW_RECORD][commission_type]" value="COMMISSION_TYPE_VALUE">
                  <input type="hidden" name="habitation[broker_assignments_attributes][NEW_RECORD][commission_value]" value="COMMISSION_VALUE_VALUE">
                  
                  <div class="d-flex justify-content-between align-items-start">
                    <div>
                      <div class="fw-bold extra-small text-primary mb-1">
                        <span class="badge bg-primary extra-small me-1">ROLE_LABEL</span>
                        BROKER_NAME
                      </div>
                      <div class="text-muted smaller font-monospace">
                        COMMISSION_VALUE_DISPLAY
                      </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-link text-danger p-0" data-action="habitation-brokers#remove">
                      <i class="bi bi-x-circle"></i>
                    </button>
                  </div>
                </div>
              </template>

                <!-- Modal for Adding Broker -->
                <div class="modal fade" id="addBrokerModal" tabindex="-1" aria-hidden="true" data-habitation-brokers-target="modal">
                  <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg">
                      <div class="modal-header bg-primary text-white py-2">
                        <h6 class="modal-title fw-bold"><i class="bi bi-person-plus me-2"></i>Adicionar corretor</h6>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <div class="modal-body p-3">
                        <div class="mb-2">
                          <label class="form-label fw-bold extra-small mb-1">Tipo:</label>
                          <%= select_tag "broker_type", 
                              options_for_select(HabitationBrokerAssignment.roles.map { |k,v| [v, k] }), 
                              { prompt: "Escolha o tipo", class: "form-select form-select-sm", data: { habitation_brokers_target: "typeSelect" } } %>
                        </div>

                        <div class="mb-2">
                          <label class="form-label fw-bold extra-small mb-1">Selecione o corretor:</label>
                          <%= select_tag :broker_id, options_from_collection_for_select(@brokers, :id, :name), 
                              { include_blank: true, class: "form-select form-select-sm", 
                                data: { habitation_brokers_target: "brokerSelect", controller: "tom-select", placeholder: "Selecione..." } } %>
                        </div>

                        <div class="row g-2 mb-2">
                          <div class="col-md-6">
                            <label class="form-label fw-bold extra-small mb-1">Tipo de comissão:</label>
                            <%= select_tag "commission_type", 
                                options_for_select([['$ - Preço', 'fixed'], ['% - Porcentagem', 'percentage']]), 
                                { prompt: "Tipo...", class: "form-select form-select-sm", data: { habitation_brokers_target: "commissionTypeSelect" } } %>
                          </div>
                          <div class="col-md-6">
                            <label class="form-label fw-bold extra-small mb-1">Comissão:</label>
                            <input type="text" class="form-control form-control-sm" data-habitation-brokers-target="commissionValueInput" placeholder="0,00">
                          </div>
                        </div>
                      </div>
                      <div class="modal-footer bg-light py-2">
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn btn-sm btn-primary" data-action="habitation-brokers#add">Adicionar</button>
                      </div>
                    </div>
                  </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
    <!-- Tab: Mídia (Existing) -->
    <div class="tab-pane fade" id="media" role="tabpanel" aria-labelledby="media-tab">
       <div class="card border-0 shadow-sm mb-4">
         <div class="card-body p-3 p-md-4" data-controller="photo-upload fancybox-gallery">
            <h6 class="small fw-semibold text-uppercase text-muted mb-3">Fotos</h6>
            <% linked_development = habitation.empreendimento if habitation.codigo_empreendimento.present? %>
            <% if linked_development.present? %>
              <div class="alert alert-light border d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
                <div>
                  <div class="fw-semibold small mb-1">
                    <i class="bi bi-building me-1 text-primary"></i>
                    Fotos do empreendimento vinculado
                  </div>
                  <div class="text-muted small">
                    Este imóvel está vinculado a <strong><%= linked_development.nome_empreendimento.presence || linked_development.codigo %></strong>.
                    Se não houver fotos próprias, ele pode usar as fotos desse empreendimento.
                  </div>
                </div>
                <div class="form-check form-switch m-0">
                  <%= f.check_box :use_development_photos_flag, class: "form-check-input", role: "switch" %>
                  <%= f.label :use_development_photos_flag, "Usar fotos do empreendimento", class: "form-check-label small fw-semibold" %>
                </div>
              </div>
            <% end %>
            <div class="mb-4 text-center p-5 border border-dashed rounded bg-light">
               <% if can?(:manage, :imoveis) %>
                 <div class="row justify-content-center mb-3">
                   <div class="col-md-4">
                     <%= f.label :foto_classificacao, "Classificação das Fotos:", class: "form-label small fw-bold mb-1" %>
                     <%= f.select :foto_classificacao, Habitation::FOTO_CLASSIFICACAO, { include_blank: "Selecione..." }, class: "form-select form-select-sm" %>
                   </div>
                 </div>
               <% end %>
               <div class="mb-3">
                 <i class="bi bi-images display-4 text-muted"></i>
               </div>
               <h5>Arraste fotos ou clique para selecionar</h5>
               <p class="text-muted small">Fotos adicionadas aqui sobressaem as da integração API.</p>
               <%= f.label :photos, "Selecionar Arquivos", class: "btn btn-primary" %>
               <%= f.file_field :photos, multiple: true, class: "d-none", 
                   id: "habitation_photos",
                   data: { action: "change->photo-upload#preview", photo_upload_target: "input" } %>
               <%= f.hidden_field :ordered_photo_ids, data: { photo_upload_target: "orderInput" }, value: f.object.photo_ids_order.join(',') %>
               <%= f.hidden_field :ordered_picture_indices,
                   data: { photo_upload_target: "apiOrderInput" },
                   value: habitation.pictures.is_a?(Array) ? habitation.pictures.each_index.to_a.join(',') : "" %>
            </div>

            <div class="row g-3" data-photo-upload-target="previewContainer">
                 <% if habitation.photos.attached? %>
                    <% habitation.ordered_photos.each do |photo| %>
                      <% next unless photo.persisted? && photo.blob&.persisted? %>
                      <div class="col-6 col-md-3 col-lg-2 draggable-item attached-photo-item" data-id="<%= photo.id %>">
                        <div class="position-relative ratio ratio-1x1 group-hover cursor-grab">
                          <%= link_to url_for(photo),
                              class: "d-block w-100 h-100",
                              data: { fancybox: "habitation-media-gallery", caption: photo.filename.to_s } do %>
                            <%= image_tag photo, class: "rounded border w-100 h-100 object-fit-cover" %>
                          <% end %>
                          <div class="position-absolute top-0 end-0 p-1">
                             <span class="badge bg-light text-dark border shadow-sm">Ativo</span>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  <% end %>
                  
                  <% if habitation.pictures.present? && habitation.pictures.is_a?(Array) %>
                     <% habitation.pictures.each_with_index do |pic, index| %>
                        <% pic_url = pic.is_a?(String) ? pic : (pic.try(:[], 'url') || pic.try(:[], 'src') || pic.try(:[], 'link')) %>
                        <% if pic_url.present? %>
                           <div class="col-6 col-md-3 col-lg-2 draggable-item api-picture-item" data-api-index="<%= index %>">
                              <div class="position-relative ratio ratio-1x1 group-hover cursor-grab">
                                 <%= link_to pic_url,
                                     class: "d-block w-100 h-100",
                                     data: { fancybox: "habitation-media-gallery", caption: "Foto API/Vista #{index + 1}" } do %>
                                   <%= image_tag pic_url, class: "rounded border w-100 h-100 object-fit-cover opacity-75" %>
                                 <% end %>
                                 <div class="position-absolute top-0 end-0 p-1">
                                    <span class="badge bg-secondary border shadow-sm" title="Vindo da Integração API">API/Vista</span>
                                 </div>
                              </div>
                           </div>
                        <% end %>
                     <% end %>
                  <% end %>

                  <% if habitation.use_development_photos? && linked_development.present? && habitation.own_public_image_sources.blank? %>
                    <% linked_development.own_public_image_sources.first(12).each_with_index do |pic, index| %>
                      <% development_photo_url = public_image_url(pic) %>
                      <div class="col-6 col-md-3 col-lg-2">
                        <div class="position-relative ratio ratio-1x1 group-hover">
                          <%= link_to development_photo_url,
                              class: "d-block w-100 h-100",
                              data: { fancybox: "habitation-media-gallery", caption: "Foto do empreendimento #{index + 1}" } do %>
                            <%= image_tag development_photo_url, class: "rounded border w-100 h-100 object-fit-cover opacity-75" %>
                          <% end %>
                          <div class="position-absolute top-0 end-0 p-1">
                            <span class="badge bg-info text-dark border shadow-sm" title="Foto herdada do empreendimento">Empreendimento</span>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  <% end %>
            </div>
         </div>
       </div>
       
       <div class="card border-0 shadow-sm mb-4" data-controller="dynamic-list" data-dynamic-list-param-name-value="habitation[videos][]">
          <div class="card-body p-3 p-md-4">
             <div class="d-flex justify-content-between align-items-center mb-3">
               <h6 class="small fw-semibold text-uppercase text-muted mb-0">Vídeos e tour virtual</h6>
               <button type="button" class="btn btn-sm btn-outline-primary" data-action="dynamic-list#add">
                 <i class="bi bi-plus-lg me-1"></i>Adicionar
               </button>
             </div>
             <div class="mb-3" data-dynamic-list-target="container">
                <% (f.object.videos || []).each do |video_url| %>
                  <div class="input-group mb-2">
                     <input type="text" name="habitation[videos][]" value="<%= video_url %>" class="form-control form-control-sm" placeholder="https://...">
                     <button type="button" class="btn btn-outline-danger" data-action="dynamic-list#remove">
                       <i class="bi bi-trash"></i>
                     </button>
                  </div>
                <% end %>
             </div>
             <div class="mt-4">
                <%= f.label :tour_virtual, "Link Tour Virtual (360)", class: "form-label fw-bold" %>
                <%= f.text_field :tour_virtual, class: "form-control form-control-sm", placeholder: "https://..." %>
             </div>
             <div class="mt-2">
                <%= f.label :podcast_url, "Link do Podcast", class: "form-label fw-bold" %>
                <%= f.text_field :podcast_url, class: "form-control form-control-sm", placeholder: "https://..." %>
             </div>
          </div>
       </div>
    </div>

    <!-- Tab: Documentos (anexos internos) -->
    <div class="tab-pane fade" id="documents" role="tabpanel" aria-labelledby="documents-tab">
      <div class="alert alert-info border-0 small mb-4">
        <i class="bi bi-info-circle me-1"></i>
        Documentos internos do imóvel — visíveis apenas para a equipe administrativa. Não aparecem no site público.
      </div>

      <div class="row g-3">
        <!-- Fichas de cadastro -->
        <div class="col-lg-6">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 p-md-4">
              <h6 class="small fw-semibold text-uppercase text-muted mb-3">
                <i class="bi bi-file-earmark-text me-1"></i> Fichas de Cadastro
              </h6>
              <p class="small text-muted mb-3">
                PDFs ou imagens da ficha física de cadastro do imóvel. Pode anexar vários arquivos.
              </p>

              <div class="mb-3">
                <%= f.label :fichas_cadastro, "Adicionar arquivos", class: "btn btn-outline-primary btn-sm" %>
                <%= f.file_field :fichas_cadastro, multiple: true, class: "d-none", id: "habitation_fichas_cadastro" %>
              </div>

              <% if habitation.fichas_cadastro.attached? %>
                <ul class="list-group list-group-flush small">
                  <% habitation.fichas_cadastro.attachments.each do |attachment| %>
                    <% next unless attachment.persisted? && attachment.blob&.persisted? %>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                      <div class="d-flex align-items-center gap-2 flex-grow-1 text-truncate">
                        <i class="bi bi-paperclip text-muted"></i>
                        <%= link_to attachment.filename.to_s,
                                    rails_blob_path(attachment, disposition: "attachment"),
                                    target: "_blank", rel: "noopener",
                                    class: "text-decoration-none text-truncate" %>
                        <span class="badge bg-light text-muted border ms-1">
                          <%= number_to_human_size(attachment.byte_size) rescue '-' %>
                        </span>
                      </div>
                      <% if habitation.persisted? %>
                        <%= button_to purge_attachment_admin_habitation_path(habitation, association: "fichas_cadastro", attachment_id: attachment.id),
                                      method: :delete,
                                      class: "btn btn-sm btn-link text-danger p-0 ms-2",
                                      form: { data: { turbo_confirm: "Remover este arquivo?" } } do %>
                          <i class="bi bi-trash"></i>
                        <% end %>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <p class="small text-muted fst-italic mb-0">Nenhuma ficha anexada.</p>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Autorizações de venda -->
        <div class="col-lg-6">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 p-md-4">
              <h6 class="small fw-semibold text-uppercase text-muted mb-3">
                <i class="bi bi-shield-check me-1"></i> Autorizações de Venda
              </h6>
              <p class="small text-muted mb-3">
                Imagens (JPG/PNG) ou PDFs de autorizações assinadas pelo proprietário. Pode anexar várias.
              </p>

              <div class="mb-3">
                <%= f.label :autorizacoes_venda, "Adicionar arquivos", class: "btn btn-outline-primary btn-sm" %>
                <%= f.file_field :autorizacoes_venda, multiple: true, class: "d-none", id: "habitation_autorizacoes_venda" %>
              </div>

              <% if habitation.autorizacoes_venda.attached? %>
                <ul class="list-group list-group-flush small">
                  <% habitation.autorizacoes_venda.attachments.each do |attachment| %>
                    <% next unless attachment.persisted? && attachment.blob&.persisted? %>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                      <div class="d-flex align-items-center gap-2 flex-grow-1 text-truncate">
                        <% if attachment.image? %>
                          <%= image_tag attachment, class: "rounded border", style: "width: 36px; height: 36px; object-fit: cover;" %>
                        <% else %>
                          <i class="bi bi-file-earmark-pdf text-danger fs-5"></i>
                        <% end %>
                        <%= link_to attachment.filename.to_s,
                                    rails_blob_path(attachment, disposition: "attachment"),
                                    target: "_blank", rel: "noopener",
                                    class: "text-decoration-none text-truncate" %>
                        <span class="badge bg-light text-muted border ms-1">
                          <%= number_to_human_size(attachment.byte_size) rescue '-' %>
                        </span>
                      </div>
                      <% if habitation.persisted? %>
                        <%= button_to purge_attachment_admin_habitation_path(habitation, association: "autorizacoes_venda", attachment_id: attachment.id),
                                      method: :delete,
                                      class: "btn btn-sm btn-link text-danger p-0 ms-2",
                                      form: { data: { turbo_confirm: "Remover este arquivo?" } } do %>
                          <i class="bi bi-trash"></i>
                        <% end %>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <p class="small text-muted fst-italic mb-0">Nenhuma autorização anexada.</p>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab: SEO & Controle -->
    <div class="tab-pane fade" id="seo" role="tabpanel" aria-labelledby="seo-tab">
      <div class="row g-3">
         <div class="col-lg-12">
           <div class="card border-0 shadow-sm mb-4">
             <div class="card-body p-3 p-md-4">
               <h6 class="small fw-semibold text-uppercase text-muted mb-3">Otimização para busca (SEO)</h6>
               <div class="row g-2">
                 <div class="col-md-6">
                    <%= f.label :slug, "URL Amigável (Slug)", class: "form-label small fw-bold mb-1" %>
                    <%= f.text_field :slug, class: "form-control form-control-sm bg-light", readonly: true %>
                 </div>
                 <div class="col-md-6">
                    <%= f.label :meta_title, "Meta Title", class: "form-label small fw-bold mb-1" %>
                    <%= f.text_field :meta_title, class: "form-control form-control-sm" %>
                 </div>
                 <div class="col-12 mt-2">
                    <%= f.label :meta_description, "Meta Description (SEO)", class: "form-label small fw-bold mb-1" %>
                    <%= f.rich_text_area :meta_description, class: "form-control", style: "min-height: 150px;" %>
                 </div>
                 <div class="col-12 mt-2">
                    <%= f.label :meta_keywords, "Palavras-chave (Tags)", class: "form-label small fw-bold mb-1" %>
                    <%= f.text_field :meta_keywords, 
                        class: "form-control form-control-sm",
                        placeholder: "Digite e Enter...",
                        data: { controller: "tom-select", tom_select_tags_value: true } %>
                 </div>
               </div>
             </div>
           </div>
         </div>

         <div class="col-lg-12">
           <div class="alert alert-light border small mb-0">
             Os controles de exibição estão na seção <strong>Identificação e Sinalizadores</strong> para evitar duplicidade.
           </div>
         </div>
      </div>
  </div>

  <!-- Sticky Footer Action Bar -->
  <div class="position-sticky bottom-0 bg-white py-3 border-top mt-4 shadow-lg habitation-action-bar">
    <div class="d-flex justify-content-between align-items-center habitation-action-inner">
      <div class="text-muted small habitation-action-meta">
        <% if f.object.updated_at %>
          <i class="bi bi-clock-history me-1"></i> Última atualização: <%= f.object.updated_at.strftime("%d/%m/%Y às %H:%M") %>
        <% end %>
      </div>
      <div class="habitation-action-buttons">
         <%= link_to "Cancelar", admin_habitations_path, class: "btn btn-outline-secondary px-4 px-md-4", data: { save_state_target: "cancelButton" } %>
         <% if can_release_intake_to_broker?(habitation) %>
           <%= f.button type: "submit",
                        name: "release_to_broker_after_save",
                        value: "1",
                        class: "btn btn-success px-4 px-md-4 fw-bold",
                        data: { habitation_duplicate_check_target: "submit" } do %>
             Salvar e devolver ao corretor
           <% end %>
         <% end %>
         <%= f.button type: "submit", class: "btn btn-primary px-4 px-md-5 fw-bold", data: { save_state_target: "submitButton", habitation_duplicate_check_target: "submit" } do %>
           <span class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true" data-save-state-target="spinner"></span>
           <span data-save-state-target="label">Salvar Imóvel</span>
         <% end %>
      </div>
    </div>
  </div>
<% end %>
<%= render "admin/shared/attribute_manager_modal", modal_id: "attributeManagerModal" %>

</div>
