<%
  cadastro_categories = {
    "apartamentos" => ["Apartamento", "Cobertura", "Loft", "Studio"],
    "comerciais_industriais" => ["Sala Comercial", "Loja", "Prédio Comercial", "Galpão", "Galpão Industrial", "Área", "Casa comercial", "Condomínio Industrial", "Ponto Comercial", "Salas/Conjuntos"],
    "empreendimento" => ["Empreendimento"],
    "imoveis_residenciais" => ["Casa", "Casa em Condomínio", "Sobrado", "Rural", "Condomínio", "Chácara", "Sítio"],
    "terrenos" => ["Terreno", "Terreno em Condomínio", "Área", "Terreno Comercial", "Terreno Industrial"]
  }
  cadastro_tipo_by_type = {
    "empreendimento" => "Empreendimento",
    "apartamentos" => "Unitário",
    "comerciais_industriais" => "Unitário",
    "imoveis_residenciais" => "Unitário",
    "terrenos" => "Unitário"
  }
  cadastro_type_labels = {
    "apartamentos" => "Apartamentos",
    "comerciais_industriais" => "Comerciais e Industriais",
    "empreendimento" => "Empreendimento",
    "imoveis_residenciais" => "Imóveis Residenciais",
    "terrenos" => "Terrenos"
  }
  inferred_cadastro_type =
    if habitation.tipo == "Empreendimento"
      "empreendimento"
    else
      cadastro_categories.find { |_key, values| values.include?(habitation.categoria) }&.first || "imoveis_residenciais"
    end
  show_development_context = habitation.codigo_empreendimento.present? || habitation.constructor_id.present? || habitation.tipo == "Empreendimento"
  development_lookup = @developments.each_with_object({}) do |development, hash|
    hash[development.codigo.to_s] = {
      nome_empreendimento: development.nome_empreendimento.to_s,
      constructor_id: development.constructor_id&.to_s,
      edit_url: edit_admin_habitation_path(development)
    }
  end
%>
<div data-controller="attribute-manager habitation-form"
     data-attribute-manager-modal-id-value="attributeManagerModal"
     data-habitation-form-categories-by-type-value="<%= json_escape(cadastro_categories.to_json) %>"
     data-habitation-form-tipo-by-type-value="<%= json_escape(cadastro_tipo_by_type.to_json) %>"
     data-habitation-form-developments-value="<%= json_escape(development_lookup.to_json) %>">
<%= form_with(model: [:admin, habitation], local: true, class: "needs-validation", style: "min-height: 80vh;") do |f| %>
  <% if habitation.errors.any? %>
    <div class="alert alert-danger shadow-sm border-0 mb-4">
      <h5 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i>Ops! Verifique os erros abaixo:</h5>
      <ul class="mb-0">
        <% habitation.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Navigation Tabs -->
  <div class="border-bottom mb-4">
    <ul class="nav nav-tabs border-0 gap-3" id="habitationTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active border-0 bg-transparent py-2 px-1 fw-bold text-primary border-bottom border-2 border-primary" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab" aria-selected="true">
          <i class="bi bi-house-door me-2"></i>Visão geral
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link border-0 bg-transparent py-2 px-1 text-muted" id="features-tab" data-bs-toggle="tab" data-bs-target="#features" type="button" role="tab" aria-selected="false">
          <i class="bi bi-tags me-2"></i>Características
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link border-0 bg-transparent py-2 px-1 text-muted" id="infra-tab" data-bs-toggle="tab" data-bs-target="#infra" type="button" role="tab" aria-selected="false">
          <i class="bi bi-building me-2"></i>Infraestrutura
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link border-0 bg-transparent py-2 px-1 text-muted" id="comercial-tab" data-bs-toggle="tab" data-bs-target="#comercial" type="button" role="tab" aria-selected="false">
          <i class="bi bi-briefcase me-2"></i>Comercial
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link border-0 bg-transparent py-2 px-1 text-muted" id="media-tab" data-bs-toggle="tab" data-bs-target="#media" type="button" role="tab" aria-selected="false">
          <i class="bi bi-images me-2"></i>Mídia
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link border-0 bg-transparent py-2 px-1 text-muted" id="seo-tab" data-bs-toggle="tab" data-bs-target="#seo" type="button" role="tab" aria-selected="false">
          <i class="bi bi-google me-2"></i>SEO & Controle
        </button>
      </li>
    </ul>
  </div>

  <style>
    /* Custom Tab Styles for "Modern UI" */
    #habitationTabs .nav-link {
        font-size: 0.9rem;
        transition: all 0.2s;
        color: #6c757d; /* text-muted */
        border-bottom: 2px solid transparent !important;
    }
    #habitationTabs .nav-link:hover {
        color: var(--bs-primary);
    }
    #habitationTabs .nav-link.active {
        color: var(--bs-primary) !important;
        border-bottom: 2px solid var(--bs-primary) !important;
        font-weight: bold;
    }
  </style>

  <!-- Tab Content -->
  <div class="tab-content" id="habitationTabsContent">
    
    <!-- Tab: Visão Geral -->
    <div class="tab-pane fade show active" id="general" role="tabpanel" aria-labelledby="general-tab">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <div class="form-section mb-3">
            <div class="form-section-header">
              <i class="bi bi-card-list"></i> Identificação e Sinalizadores
            </div>
            <div class="row g-3 align-items-end mb-2">
              <div class="col-md-2">
                <%= f.label :codigo, "Referência:", class: "form-label fw-bold mb-1" %>
                <%= f.text_field :codigo, class: "form-control form-control-sm bg-light", readonly: f.object.persisted? %>
              </div>
              <div class="col-md-2">
                <%= f.label :codigo_dwv, "Cód. DWV:", class: "form-label fw-bold mb-1" %>
                <%= f.text_field :codigo_dwv, class: "form-control form-control-sm" %>
              </div>
              <div class="col-md-3">
                <div class="row g-2">
                  <div class="col-6">
                    <label class="form-label small text-muted mb-0">Cadastro:</label>
                    <input type="text" class="form-control form-control-sm bg-light" value="<%= f.object.data_cadastro_crm&.strftime("%d/%m/%Y") %>" readonly>
                  </div>
                  <div class="col-6">
                    <label class="form-label small text-muted mb-0">Atualização:</label>
                    <input type="text" class="form-control form-control-sm bg-light" value="<%= (f.object.data_atualizacao_crm || f.object.updated_at)&.strftime("%d/%m/%Y") %>" readonly>
                  </div>
                </div>
              </div>
            </div>
            <div class="row g-2">
              <div class="col-12">
                <div class="d-flex flex-wrap gap-2 pb-1">
                  <label class="custom-checkbox-card">
                    <%= f.check_box :exibir_no_site_flag, class: "form-check-input mt-0" %>
                    <span class="small fw-semibold">Exibir no site</span>
                  </label>
                  <label class="custom-checkbox-card">
                    <%= f.check_box :destaque_web_flag, class: "form-check-input mt-0" %>
                    <span class="small fw-semibold">Destaque Web</span>
                  </label>
                  <label class="custom-checkbox-card">
                    <%= f.check_box :festival_salute_flag, class: "form-check-input mt-0" %>
                    <span class="small fw-semibold">Super Destaque</span>
                  </label>
                  <label class="custom-checkbox-card">
                    <%= f.check_box :lancamento_flag, class: "form-check-input mt-0" %>
                    <span class="small fw-semibold">Lançamento</span>
                  </label>
                  <label class="custom-checkbox-card">
                    <%= f.check_box :tem_placa_flag, class: "form-check-input mt-0" %>
                    <span class="small fw-semibold">Tem Placa</span>
                  </label>
                  <label class="custom-checkbox-card">
                    <%= f.check_box :exclusivo_flag, class: "form-check-input mt-0" %>
                    <span class="small fw-semibold">Exclusivo</span>
                  </label>
                  <label class="custom-checkbox-card">
                    <%= f.check_box :imovel_dwv, { class: "form-check-input mt-0" }, "Sim", "Não" %>
                    <span class="small fw-semibold">Imóvel DWV</span>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <div class="form-section mb-3">
            <div class="form-section-header">
              <i class="bi bi-sliders"></i> Definições Básicas
            </div>
            <div class="row g-2 mb-0">
              <div class="col-md-3">
                <label class="form-label small fw-bold mb-1">Tipo de cadastro:</label>
                <%= select_tag :ui_cadastro_type,
                    options_for_select(cadastro_type_labels.map { |k, v| [v, k] }, inferred_cadastro_type),
                    class: "form-select form-select-sm",
                    data: {
                      controller: "tom-select",
                      habitation_form_target: "cadastroType",
                      action: "change->habitation-form#cadastroTypeChanged"
                    } %>
                <%= f.hidden_field :tipo, value: (f.object.tipo.presence || cadastro_tipo_by_type[inferred_cadastro_type]), data: { habitation_form_target: "tipo" } %>
              </div>
              <div class="col-md-2">
                <%= f.label :categoria, "Categoria:", class: "form-label small fw-bold mb-1" %>
                <%= f.select :categoria, (@categories.presence || Habitation::CATEGORIES), { include_blank: true },
                    data: { controller: "tom-select", tom_select_create_value: true, placeholder: "Selecione...", habitation_form_target: "category" },
                    class: "form-select form-select-sm" %>
              </div>
              <div class="col-md-2">
                <%= f.label :status, "Status:", class: "form-label small fw-bold mb-1" %>
                <%= f.select :status, Habitation::STATUS_OPTIONS, { include_blank: true },
                    class: "form-select form-select-sm", data: { controller: "tom-select", placeholder: "Selecione..." } %>
              </div>
              <div class="col-md-2">
                <%= f.label :situacao, "Situação:", class: "form-label small fw-bold mb-1" %>
                <%= f.select :situacao, Habitation::SITUATIONS, { include_blank: true },
                    class: "form-select form-select-sm", data: { controller: "tom-select", placeholder: "Selecione..." } %>
              </div>
              <div class="col-md-2">
                <%= f.label :ocupacao_status, "Ocupação:", class: "form-label small fw-bold mb-1" %>
                <%= f.select :ocupacao_status, Habitation::OCUPACAO_STATUS, { include_blank: true },
                    class: "form-select form-select-sm" %>
              </div>
              <div class="col-md-2">
                <%= f.label :estado_conservacao, "Estado:", class: "form-label small fw-bold mb-1" %>
                <%= f.select :estado_conservacao, Habitation::ESTADO_CONSERVACAO, { include_blank: true },
                    class: "form-select form-select-sm" %>
              </div>
            </div>
          </div>

          <div class="form-section mb-3">
            <div class="form-section-header d-flex align-items-center justify-content-between">
              <span><i class="bi bi-building"></i> Definições de Empreendimento e Construtora</span>
              <button class="btn btn-sm btn-link text-decoration-none p-0"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#developmentContextCollapse"
                      aria-expanded="<%= show_development_context ? 'true' : 'false' %>"
                      aria-controls="developmentContextCollapse">
                Abrir/fechar <i class="bi bi-chevron-down ms-1"></i>
              </button>
            </div>
            <div class="collapse <%= 'show' if show_development_context %>" id="developmentContextCollapse">
              <div class="pt-2">
                <div class="row g-2 mb-3">
                  <div class="col-md-5" data-habitation-form-target="unitOnly">
                    <%= f.label :codigo_empreendimento, "Pertence ao empreendimento:", class: "form-label small fw-bold mb-1" %>
                    <div class="input-group input-group-sm">
                      <%= f.collection_select :codigo_empreendimento, @developments, :codigo, :nome_empreendimento, { include_blank: true },
                          { class: "form-select form-select-sm", data: { controller: "tom-select", placeholder: "Selecione...", habitation_form_target: "developmentSelect", action: "change->habitation-form#developmentChanged" } } %>
                      <%= link_to new_admin_habitation_path(habitation: { tipo: "Empreendimento" }),
                          class: "btn btn-outline-secondary",
                          title: "Cadastrar novo empreendimento",
                          target: "_blank",
                          rel: "noopener" do %>
                        <i class="bi bi-plus"></i>
                      <% end %>
                    </div>
                    <% linked_dev = f.object.empreendimento %>
                    <% if f.object.codigo_empreendimento.present? %>
                      <% if linked_dev.present? %>
                        <div class="form-text text-success extra-small mt-1">
                          <i class="bi bi-check-circle me-1"></i>
                          Vínculo ativo: <strong><%= linked_dev.nome_empreendimento.presence || linked_dev.codigo %></strong>
                        </div>
                      <% else %>
                        <div class="form-text text-danger extra-small mt-1">
                          <i class="bi bi-exclamation-triangle me-1"></i>
                          Código sem empreendimento válido. Ajuste antes de salvar.
                        </div>
                      <% end %>
                    <% else %>
                      <div class="form-text text-muted extra-small mt-1">
                        <i class="bi bi-info-circle me-1"></i>Ao vincular uma unidade, nome do empreendimento e construtora são herdados automaticamente.
                      </div>
                    <% end %>
                  </div>
                  <div class="col-md-4" data-habitation-form-target="unitOnly">
                    <%= f.label :nome_empreendimento, "Nome do condomínio:", class: "form-label small fw-bold mb-1" %>
                    <%= f.text_field :nome_empreendimento, class: "form-control form-control-sm", readonly: f.object.codigo_empreendimento.present?, data: { habitation_form_target: "developmentName" } %>
                    <div class="form-text text-muted extra-small mt-1">Campo gerenciado automaticamente para unidades vinculadas.</div>
                  </div>
                  <div class="col-md-3">
                    <%= f.label :data_entrega, "Data entrega:", class: "form-label small fw-bold mb-1" %>
                    <%= f.date_field :data_entrega, class: "form-control form-control-sm" %>
                  </div>
                </div>

                <div class="row g-2">
                  <div class="col-md-5">
                    <%= f.label :constructor_id, "Construtora:", class: "form-label small fw-bold mb-1" %>
                    <%= f.collection_select :constructor_id, @constructors, :id, :name, { include_blank: "Selecione..." }, {
                        class: "form-select form-select-sm",
                        data: { habitation_form_target: "constructorSelect", controller: "tom-select", placeholder: "Selecione..." }
                    } %>
                    <div class="alert alert-warning py-2 px-3 small mt-2 d-none"
                         data-habitation-form-target="missingConstructorAlert">
                      <i class="bi bi-exclamation-triangle me-1"></i>
                      Este empreendimento não possui construtora/incorporadora vinculada.
                      <button type="button"
                              class="btn btn-link btn-sm p-0 ms-1 align-baseline"
                              data-bs-toggle="modal"
                              data-bs-target="#quickAddConstructorModal">
                        Cadastrar agora
                      </button>
                      <a href="#"
                         class="ms-2"
                         target="_blank"
                         rel="noopener"
                         data-habitation-form-target="developmentEditLink">
                        Ir para empreendimento
                      </a>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                      <button type="button" class="btn btn-outline-primary btn-sm"
                              data-bs-toggle="modal" data-bs-target="#quickAddConstructorModal">
                        <i class="bi bi-plus-lg me-1"></i>Nova construtora
                      </button>
                    </div>
                    <% if f.object.codigo_empreendimento.present? && f.object.empreendimento&.constructor_name.present? %>
                      <div class="form-text text-muted extra-small mt-1">
                        Herdada do empreendimento: <strong><%= f.object.empreendimento.constructor_name %></strong>.
                      </div>
                    <% else %>
                      <div class="form-text text-muted extra-small mt-1">
                        Campo opcional. Pode salvar sem construtora e vincular depois.
                      </div>
                    <% end %>
                  </div>
                  <div class="col-md-3">
                    <%= f.label :perfil_construcao, "Perfil de construção:", class: "form-label small fw-bold mb-1" %>
                    <%= f.select :perfil_construcao, Habitation::CONSTRUCTION_PROFILES, { include_blank: true }, class: "form-select form-select-sm" %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section: Endereço e Localização -->
          <div class="form-section">
            <div class="form-section-header">
              <i class="bi bi-geo-alt"></i> Endereço e Localização
            </div>
          <%= f.fields_for :address do |address_form| %>
            <div data-controller="cep-search">
            <div class="row g-2 mb-3">
              <div class="col-md-2">
                <%= address_form.label :tipo_endereco, "Endereço:", class: "form-label small fw-bold mb-1" %>
                <%= address_form.select :tipo_endereco, Habitation::STREET_TYPES, { include_blank: true }, class: "form-select form-select-sm", data: { cep_search_target: "tipo" } %>
              </div>
              <div class="col-md-5">
                <%= address_form.label :logradouro, "Logradouro:", class: "form-label small fw-bold mb-1" %>
                <%= address_form.text_field :logradouro, class: "form-control form-control-sm", placeholder: "Rua, Av...", data: { cep_search_target: "logradouro" } %>
              </div>
              <div class="col-md-1">
                <%= address_form.label :numero, "Nº:", class: "form-label small fw-bold mb-1" %>
                <%= address_form.text_field :numero, class: "form-control form-control-sm", data: { cep_search_target: "numero" } %>
              </div>
              <div class="col-md-2">
                <%= address_form.label :complemento, "Compl.:", class: "form-label small fw-bold mb-1" %>
                <%= address_form.text_field :complemento, class: "form-control form-control-sm", data: { cep_search_target: "complemento" } %>
              </div>
              <div class="col-md-1">
                <%= address_form.label :uf, "UF:", class: "form-label small fw-bold mb-1" %>
                <%= address_form.select :uf, Habitation::UF_OPTIONS, { include_blank: true }, class: "form-select form-select-sm", data: { cep_search_target: "uf" } %>
              </div>
              <div class="col-md-2">
                <%= address_form.label :cep, "CEP:", class: "form-label small fw-bold mb-1" %>
                <div class="input-group input-group-sm">
                  <%= address_form.text_field :cep, class: "form-control form-control-sm",
                      data: { controller: "mask", mask_type_value: "cep", cep_search_target: "cep", action: "blur->cep-search#search" } %>
                  <button class="btn btn-primary" type="button" data-action="cep-search#search">
                    <i class="bi bi-search"></i>
                  </button>
                </div>
              </div>
            </div>

            <div class="row g-2 mb-3">
              <div class="col-md-3">
                <%= address_form.label :bairro, "Bairro:", class: "form-label small fw-bold mb-1" %>
                <%= address_form.select :bairro, @neighborhoods, { include_blank: true, selected: address_form.object.bairro },
                    data: { controller: "tom-select", tom_select_create_value: true, cep_search_target: "bairro" },
                    class: "form-select form-select-sm" %>
              </div>
              <div class="col-md-2">
                <%= address_form.label :bairro_comercial, "Bairro comercial:", class: "form-label small fw-bold mb-1" %>
                <%= address_form.text_field :bairro_comercial, class: "form-control form-control-sm" %>
              </div>
              <div class="col-md-3">
                <%= address_form.label :cidade, "Cidade:", class: "form-label small fw-bold mb-1" %>
                <%= address_form.select :cidade, @cities, { include_blank: true, selected: address_form.object.cidade },
                    data: { controller: "tom-select", tom_select_create_value: true, cep_search_target: "cidade" },
                    class: "form-select form-select-sm" %>
              </div>
              <div class="col-md-1">
                <%= f.label :bloco, "Bloco:", class: "form-label small fw-bold mb-1" %>
                <%= f.text_field :bloco, class: "form-control form-control-sm" %>
              </div>
              <div class="col-md-3">
                <%= address_form.label :imediacoes, "Imediações:", class: "form-label small fw-bold mb-1" %>
                <% selected_imediacoes = case address_form.object.imediacoes
                   when String then address_form.object.imediacoes.split(/[,\n;]+/)
                   else Array(address_form.object.imediacoes)
                   end.flatten.compact.map(&:to_s).map(&:strip).reject(&:blank?).uniq %>
                <% imediacoes_options = (@imediacoes_options.to_a + selected_imediacoes).uniq %>
                <div class="d-flex align-items-stretch gap-1">
                  <div class="flex-grow-1">
                    <%= address_form.select :imediacoes, options_for_select(imediacoes_options, selected_imediacoes), {}, {
                        id: "address-imediacoes-tags",
                        multiple: true,
                        class: "form-select form-select-sm",
                        data: { controller: "tom-select", tom_select_tags_value: true }
                    } %>
                  </div>
                  <button type="button"
                          class="btn btn-outline-primary btn-sm px-2"
                          title="Gerenciar Imediações"
                          aria-label="Gerenciar Imediações"
                          data-attribute-manager-context-value="habitation"
                          data-attribute-manager-category-value="imediacoes"
                          data-attribute-manager-field-name-value="habitation[address_attributes][imediacoes][]"
                          data-attribute-manager-modal-id-value="attributeManagerModal"
                          data-action="click->attribute-manager#open"
                          data-title="Gerenciar Imediações"
                          data-select-id="address-imediacoes-tags">
                    <i class="bi bi-gear"></i>
                  </button>
                </div>
              </div>
            </div>
          <% end %>
          </div>
          </div>

          <!-- Section: Rooms & Features -->
          <div class="form-section">
            <div class="form-section-header">
              <i class="bi bi-grid-1x2"></i> DIMENSÕES & ESTRUTURA FÍSICA
            </div>
            
            <!-- Row 6: Cômodos -->
          <div class="row g-2 mb-3">
            <div class="col-md-1">
              <%= f.label :andar, "Andar:", class: "form-label small fw-bold mb-1" %>
              <%= f.number_field :andar, class: "form-control form-control-sm" %>
            </div>
            <div class="col-md-1">
              <%= f.label :dormitorios_qtd, "Dorm.:", class: "form-label small fw-bold mb-1" %>
              <%= f.number_field :dormitorios_qtd, class: "form-control form-control-sm" %>
            </div>
            <div class="col-md-1">
              <%= f.label :suites_qtd, "Suítes:", class: "form-label small fw-bold mb-1" %>
              <%= f.number_field :suites_qtd, class: "form-control form-control-sm" %>
            </div>
