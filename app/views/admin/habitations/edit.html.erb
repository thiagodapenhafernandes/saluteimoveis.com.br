<% content_for :submit_text, "Atualizar Imóvel" %>

  <div class="d-flex justify-content-between align-items-center">
    <div>
      <h1 class="h3 mb-0 text-gray-800">Editar Imóvel <span class="text-muted h5">#<%= @habitation.codigo %></span></h1>
    </div>
    <div class="d-flex gap-2">
      <%= link_to admin_habitations_path, class: "btn btn-outline-secondary btn-sm" do %>
        <i class="bi bi-arrow-left me-1"></i> Voltar
      <% end %>
      <%= link_to habitation_path(@habitation), target: "_blank", class: "btn btn-primary btn-sm" do %>
        <i class="bi bi-eye me-1"></i> Visualizar no Site
      <% end %>
    </div>
  </div>

<%= render 'form', habitation: @habitation %>
