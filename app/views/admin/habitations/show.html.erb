    ["Área total", @habitation.area_total_m2.present? ? "#{@habitation.area_total_m2} m²" : nil],
    ["Área útil", @habitation.area_util_m2.present? ? "#{@habitation.area_util_m2} m²" : nil],
    ["Área terreno", @habitation.area_terreno_m2.present? ? "#{@habitation.area_terreno_m2} m²" : nil],
    ["Dimensões terreno", @habitation.dimensoes_terreno],
    ["Topografia", @habitation.topografia],
    ["Face", @habitation.face],
    ["Andar", @habitation.andar],
    ["Aptos por andar", @habitation.aptos_andar],
    ["Aptos no edifício", @habitation.aptos_edificio],
    ["Elevadores", @habitation.elevadores_qtd],
    ["Ano construção", @habitation.ano_construcao],
    ["Data entrega", @habitation.data_entrega]
  ]

  commercial_fields = [
    ["Venda", money.call(@habitation.valor_venda_cents)],
    ["Venda anterior", money.call(@habitation.valor_venda_anterior_cents)],
    ["Locação", money.call(@habitation.valor_locacao_cents)],
    ["Aluguel anterior", money.call(@habitation.valor_locacao_anterior_cents)],
    ["Valor promocional", money.call(@habitation.valor_promocional_cents)],
    ["Total aluguel", money.call(@habitation.valor_total_aluguel_cents)],
    ["Condomínio", money.call(@habitation.valor_condominio_cents)],
    ["IPTU", money.call(@habitation.valor_iptu_cents)],
