%>

<div class="habitation-show-page">
  <div class="habitation-show-header d-flex justify-content-between align-items-start gap-3 flex-wrap">
    <div class="flex-grow-1" style="min-width: 0;">
      <div class="habitation-show-meta">
        <i class="bi bi-hash"></i><%= @habitation.codigo %>
        <% if @habitation.status.present? %>
          · <span class="badge bg-light text-dark border fw-normal"><%= @habitation.status %></span>
        <% end %>
        <% if @habitation.categoria.present? %>
          · <span><%= @habitation.categoria %></span>
        <% end %>
      </div>
      <div class="habitation-show-title mt-1">
        <%= @habitation.titulo_anuncio.presence || @habitation.display_title || "Detalhes do imóvel" %>
      </div>
      <% if address_parts.any? %>
        <div class="habitation-show-meta mt-2">
          <i class="bi bi-geo-alt"></i>
          <%= address_parts.join(" · ") %>
        </div>
      <% end %>
    </div>

    <div class="habitation-show-actions d-flex gap-2 flex-wrap">
      <%= link_to (@return_to_path || admin_habitations_path), class: "btn btn-outline-secondary btn-sm" do %>
        <i class="bi bi-arrow-left"></i><span class="ms-1">Voltar</span>
      <% end %>
      <% if can_edit_habitation?(@habitation) %>
        <%= link_to edit_admin_habitation_path(@habitation, return_to: @return_to_path), class: "btn btn-primary btn-sm" do %>
          <i class="bi bi-pencil-square"></i><span class="ms-1">Editar cadastro</span>
        <% end %>
      <% end %>
      <%= link_to habitation_path(@habitation), target: "_blank", rel: "noopener", class: "btn btn-outline-primary btn-sm" do %>
        <i class="bi bi-box-arrow-up-right"></i><span class="ms-1">Ver no site</span>
      <% end %>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-12 col-xl-5">
      <div class="habitation-show-card h-100" data-controller="fancybox-gallery">
        <% if primary_photo.present? %>
          <%= link_to primary_photo[:url], data: { fancybox: "admin-habitation-show-gallery", caption: primary_photo[:caption] } do %>
            <%= image_tag primary_photo[:thumb], class: "habitation-show-photo mb-3", alt: primary_photo[:caption] %>
          <% end %>
        <% else %>
          <div class="habitation-show-photo mb-3 d-flex align-items-center justify-content-center text-muted">
            <i class="bi bi-image display-4 opacity-25"></i>
          </div>
        <% end %>

        <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
          <div class="habitation-show-section-title mb-0">Fotos</div>
          <% if photo_sources.any? %>
            <button type="button" class="btn btn-outline-primary btn-sm fw-semibold" data-gallery-open>
              <i class="bi bi-images me-1"></i>Abrir galeria
            </button>
          <% end %>
        </div>

        <% if photo_sources.any? %>
          <div class="row g-2">
            <% photo_sources.drop(1).each do |photo| %>
              <div class="col-4">
                <%= link_to photo[:url], class: "d-block position-relative", data: { fancybox: "admin-habitation-show-gallery", caption: photo[:caption] } do %>
                  <%= image_tag photo[:thumb], class: "habitation-show-gallery-thumb", alt: photo[:caption] %>
                  <span class="position-absolute top-0 start-0 badge bg-dark bg-opacity-75 m-1"><%= photo[:badge] %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="habitation-show-muted mb-0">Nenhuma foto cadastrada.</p>
        <% end %>
      </div>
    </div>

    <div class="col-12 col-xl-7">
      <div class="habitation-show-card h-100">
        <div class="habitation-show-section-title">Identificação e cadastro</div>
        <div class="row">
          <% core_fields.each do |label, value| %>
            <div class="col-sm-6 col-lg-4 habitation-show-field">
              <div class="habitation-show-label"><%= label %></div>
              <div class="habitation-show-value"><%= show_value.call(value) %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="habitation-show-card">
        <div class="habitation-show-section-title">Endereço e localização</div>
        <div class="row">
          <% address_fields.each do |label, value| %>
            <div class="col-sm-6 col-lg-3 habitation-show-field">
              <div class="habitation-show-label"><%= label %></div>
              <div class="habitation-show-value"><%= show_value.call(value) %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="habitation-show-card">
        <div class="habitation-show-section-title">Áreas, cômodos e construção</div>
        <div class="row">
          <% areas_fields.each do |label, value| %>
            <div class="col-sm-6 col-lg-3 habitation-show-field">
              <div class="habitation-show-label"><%= label %></div>
              <div class="habitation-show-value"><%= show_value.call(value) %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="habitation-show-card">
        <div class="habitation-show-section-title">Comercial e negociação</div>
        <div class="row">
          <% commercial_fields.each do |label, value| %>
            <div class="col-sm-6 col-lg-3 habitation-show-field">
              <div class="habitation-show-label"><%= label %></div>
              <div class="habitation-show-value"><%= show_value.call(value) %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="habitation-show-card">
        <div class="habitation-show-section-title">Permuta</div>
        <div class="row">
          <% trade_fields.each do |label, value| %>
            <div class="col-sm-6 col-lg-3 habitation-show-field">
              <div class="habitation-show-label"><%= label %></div>
              <div class="habitation-show-value"><%= show_value.call(value) %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <% if can_view_sensitive_data %>
      <div class="col-12">
        <div class="habitation-show-card">
          <div class="habitation-show-section-title">Proprietário</div>
          <div class="row">
            <% owner_fields.each do |label, value| %>
              <div class="col-sm-6 col-lg-4 habitation-show-field">
                <div class="habitation-show-label"><%= label %></div>
                <div class="habitation-show-value"><%= show_value.call(value) %></div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="col-12">
      <div class="habitation-show-card">
        <div class="habitation-show-section-title">Dados internos</div>
        <div class="row">
          <% internal_fields.each do |label, value| %>
            <div class="col-sm-6 col-lg-3 habitation-show-field">
              <div class="habitation-show-label"><%= label %></div>
              <div class="habitation-show-value"><%= show_value.call(value) %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="habitation-show-card">
        <div class="habitation-show-section-title">Responsáveis e vínculos</div>
        <% if broker_rows.any? %>
          <div class="row g-2">
            <% broker_rows.each do |row| %>
              <div class="col-md-6 col-xl-4">
                <div class="habitation-show-document h-100">
                  <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                    <span class="badge bg-primary"><%= show_value.call(row[:role]) %></span>
                    <span class="small text-muted text-truncate"><%= show_value.call(row[:commission]) %></span>
                  </div>
                  <div class="fw-bold text-dark"><%= show_value.call(row[:name]) %></div>
                  <% if row[:notes].present? %>
                    <div class="small text-muted mt-1"><%= row[:notes] %></div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="habitation-show-muted mb-0">Nenhum responsável vinculado.</p>
        <% end %>
      </div>
    </div>

    <div class="col-12">
      <div class="habitation-show-card">
        <div class="habitation-show-section-title">Captação e revisão</div>
        <div class="row">
          <% intake_fields.each do |label, value| %>
            <div class="col-sm-6 col-lg-3 habitation-show-field">
              <div class="habitation-show-label"><%= label %></div>
              <div class="habitation-show-value"><%= show_value.call(value) %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="habitation-show-card">
        <div class="habitation-show-section-title">Integrações e códigos externos</div>
        <div class="row">
          <% integration_fields.each do |label, value| %>
            <div class="col-sm-6 col-lg-3 habitation-show-field">
              <div class="habitation-show-label"><%= label %></div>
              <div class="habitation-show-value"><%= show_value.call(value) %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="habitation-show-card">
        <div class="habitation-show-section-title">Publicação, portais e SEO</div>
        <div class="row">
          <% publication_fields.each do |label, value| %>
            <div class="col-sm-6 col-lg-3 habitation-show-field">
              <div class="habitation-show-label"><%= label %></div>
              <div class="habitation-show-value"><%= show_value.call(value) %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="habitation-show-card">
        <div class="habitation-show-section-title">Vídeos, plantas e links de mídia</div>
        <% if media_links.any? %>
          <div class="row g-2">
            <% media_links.each do |label, url| %>
              <div class="col-md-6 col-xl-4">
                <%= link_to url, target: "_blank", rel: "noopener", class: "habitation-show-document text-decoration-none d-flex align-items-center justify-content-between gap-2" do %>
                  <span class="fw-semibold text-dark text-truncate"><i class="bi bi-play-circle me-1 text-primary"></i><%= label %></span>
                  <i class="bi bi-box-arrow-up-right text-muted"></i>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="habitation-show-muted mb-0">Nenhum vídeo, planta ou link complementar cadastrado.</p>
        <% end %>
      </div>
    </div>

    <% if description.present? || internal_description.present? || development_description.present? || @habitation.observacoes.present? || @habitation.observacoes_visitas.present? %>
      <div class="col-12">
        <div class="habitation-show-card">
          <div class="habitation-show-section-title">Descrições e observações</div>
          <% if description.present? %>
            <h6 class="fw-bold mb-2">Descrição do site</h6>
            <div class="text-muted mb-4"><%= formatted_habitation_description(description) %></div>
          <% end %>
          <% if internal_description.present? %>
            <h6 class="fw-bold mb-2">Descrição interna</h6>
            <div class="text-muted mb-4"><%= formatted_habitation_description(internal_description) %></div>
          <% end %>
          <% if development_description.present? %>
            <h6 class="fw-bold mb-2">Descrição do empreendimento</h6>
            <div class="text-muted mb-4"><%= formatted_habitation_description(development_description) %></div>
          <% end %>
          <% if @habitation.observacoes.present? %>
            <h6 class="fw-bold mb-2">Observações</h6>
            <div class="text-muted mb-4"><%= simple_format(@habitation.observacoes) %></div>
          <% end %>
          <% if @habitation.observacoes_visitas.present? %>
            <h6 class="fw-bold mb-2">Observações de visitas</h6>
            <div class="text-muted"><%= simple_format(@habitation.observacoes_visitas) %></div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if feature_names.any? || infrastructure_names.any? || unique_feature_names.any? %>
      <div class="col-12">
        <div class="habitation-show-card">
          <div class="habitation-show-section-title">Características e infraestrutura</div>
          <div class="habitation-show-badge-list">
            <% (feature_names + infrastructure_names + unique_feature_names).compact_blank.uniq.each do |name| %>
              <span class="badge rounded-pill bg-light text-dark border px-3 py-2"><%= name %></span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <% if location_flags.any? || highlight_flags.any? %>
      <div class="col-12">
        <div class="habitation-show-card">
          <div class="habitation-show-section-title">Sinalizadores e localização estratégica</div>
          <div class="habitation-show-badge-list">
            <% (location_flags + highlight_flags).each do |label, value| %>
              <span class="badge rounded-pill bg-light text-dark border px-3 py-2">
                <%= label %><%= value.is_a?(Integer) ? ": #{value}" : "" %>
              </span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <% if can_view_sensitive_data %>
      <div class="col-12">
        <div class="habitation-show-card">
          <div class="habitation-show-section-title">Anexos e documentos internos</div>
          <div class="row g-3">
            <div class="col-lg-6">
              <h6 class="fw-bold mb-2"><i class="bi bi-file-earmark-text me-1"></i>Fichas de cadastro</h6>
              <% if @habitation.fichas_cadastro.attached? %>
                <div class="d-grid gap-2">
                  <% @habitation.fichas_cadastro.attachments.each do |attachment| %>
                    <% next unless attachment.persisted? && attachment.blob&.persisted? %>
                    <%= link_to rails_blob_path(attachment, disposition: "attachment"), target: "_blank", rel: "noopener", class: "habitation-show-document text-decoration-none d-flex align-items-center justify-content-between gap-2" do %>
                      <span class="text-dark text-truncate"><i class="bi bi-paperclip text-muted me-1"></i><%= attachment.filename %></span>
                      <span class="badge bg-light text-muted border"><%= number_to_human_size(attachment.byte_size) rescue "-" %></span>
                    <% end %>
                  <% end %>
                </div>
              <% else %>
                <p class="habitation-show-muted">Nenhuma ficha anexada.</p>
              <% end %>
            </div>

            <div class="col-lg-6">
              <h6 class="fw-bold mb-2"><i class="bi bi-shield-check me-1"></i>Autorizações de venda</h6>
              <% if @habitation.autorizacoes_venda.attached? %>
                <div class="d-grid gap-2">
                  <% @habitation.autorizacoes_venda.attachments.each do |attachment| %>
                    <% next unless attachment.persisted? && attachment.blob&.persisted? %>
                    <%= link_to rails_blob_path(attachment, disposition: "attachment"), target: "_blank", rel: "noopener", class: "habitation-show-document text-decoration-none d-flex align-items-center justify-content-between gap-2" do %>
                      <span class="text-dark text-truncate">
                        <% if attachment.image? %>
                          <%= image_tag attachment, class: "rounded border me-1", style: "width: 32px; height: 32px; object-fit: cover;" %>
                        <% else %>
                          <i class="bi bi-file-earmark-pdf text-danger me-1"></i>
                        <% end %>
                        <%= attachment.filename %>
                      </span>
                      <span class="badge bg-light text-muted border"><%= number_to_human_size(attachment.byte_size) rescue "-" %></span>
                    <% end %>
                  <% end %>
                </div>
              <% else %>
                <p class="habitation-show-muted">Nenhuma autorização anexada.</p>
              <% end %>
            </div>

            <% if vista_document_assets.any? %>
              <div class="col-12">
                <h6 class="fw-bold mb-2"><i class="bi bi-database-down me-1"></i>Documentos do Vista</h6>
                <div class="row g-2">
                  <% vista_document_assets.each do |asset| %>
                    <div class="col-md-6 col-xl-4">
                      <div class="habitation-show-document">
                        <div class="fw-semibold text-truncate"><%= asset.filename.presence || asset.source_path.presence || "Documento Vista" %></div>
                        <div class="small text-muted text-truncate"><%= asset.status.to_s.presence || "Sem status" %></div>
                        <% if asset.active_storage_attachment.present? %>
                          <%= link_to "Abrir arquivo", rails_blob_path(asset.active_storage_attachment, disposition: "attachment"), target: "_blank", rel: "noopener", class: "btn btn-sm btn-outline-primary mt-2" %>
                        <% elsif asset.source_url.present? %>
                          <%= link_to "Abrir origem", asset.source_url, target: "_blank", rel: "noopener", class: "btn btn-sm btn-outline-secondary mt-2" %>
                        <% else %>
                          <div class="small text-muted mt-2">Arquivo ainda não disponível.</div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
