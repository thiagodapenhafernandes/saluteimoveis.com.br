  highlight_flags = [
    ["Festival Salute", @habitation.festival_salute_flag],
    ["Lançamento", @habitation.lancamento_flag],
    ["Destaque web", @habitation.destaque_web_flag],
    ["Home Corporate", @habitation.home_corporate_flag],
