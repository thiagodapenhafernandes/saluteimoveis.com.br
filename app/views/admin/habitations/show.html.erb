    broker_rows << {
      role: assignment.role.to_s.presence || "Vínculo",
      name: assignment.admin_user&.name,
      commission: [assignment.commission_type.presence, assignment.commission_value.presence].compact_blank.join(": "),
      notes: assignment.observations
