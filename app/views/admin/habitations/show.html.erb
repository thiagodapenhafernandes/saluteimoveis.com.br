    ["Comissão captador", percent.call(@habitation.captador_commission_percentage)],
    ["Comissão corretor", percent.call(@habitation.broker_commission_percentage)],
    ["Aceita financiamento", yes_no.call(@habitation.aceita_financiamento_flag)],
    ["Aceita permuta", yes_no.call(@habitation.aceita_permuta_flag)],
    ["Permuta veículo", yes_no.call(@habitation.aceita_permuta_veiculo_flag)],
    ["Permuta imóvel", yes_no.call(@habitation.aceita_permuta_imovel_flag)],
    ["Permuta outros", yes_no.call(@habitation.aceita_permuta_outros_flag)],
    ["Aceita parcelamento", yes_no.call(@habitation.aceita_parcelamento_flag)],
    ["Aceita doação", yes_no.call(@habitation.aceita_doacao_flag)],
    ["Condições negociação", @habitation.condicoes_negociacao],
    ["Motivo venda", @habitation.motivo_venda],
    ["Motivo suspensão", @habitation.motivo_suspensao]
  ]

  trade_fields = [
    ["Aceita permuta", yes_no.call(@habitation.aceita_permuta_flag)],
    ["Permuta veículo", yes_no.call(@habitation.aceita_permuta_veiculo_flag)],
    ["Tipo de veículo aceito", @habitation.tipo_veiculo_aceito_permuta],
    ["Ano mínimo veículo", @habitation.ano_minimo_veiculo_aceito_permuta],
    ["Permuta imóvel", yes_no.call(@habitation.aceita_permuta_imovel_flag)],
    ["Localização desejada", @habitation.permuta_localizacao],
    ["Dormitórios desejados", @habitation.permuta_dormitorios_qtd],
    ["Suítes desejadas", @habitation.permuta_suites_qtd],
    ["Garagens desejadas", @habitation.permuta_garagens_qtd],
    ["Permuta outros", yes_no.call(@habitation.aceita_permuta_outros_flag)],
    ["Valor aceito", money.call(@habitation.valor_aceito_permuta_cents)],
    ["Valor de permuta", money.call(@habitation.permuta_valor_cents)]
