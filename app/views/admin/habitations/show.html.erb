    ["Chave/local", @habitation.key_location],
    ["Observações da chave", @habitation.key_location_notes],
    ["Responsável reserva", @habitation.responsavel_reserva],
    ["Zelador", @habitation.zelador_nome],
    ["Telefone zelador", @habitation.zelador_telefone],
    ["Região foco", @habitation.regiao_foco],
    ["Construtora", @habitation.construtora],
    ["Tipo fachada", @habitation.tipo_fachada],
    ["Andares", @habitation.andares_qtd],
    ["Perfil construção", @habitation.perfil_construcao],
    ["Matrícula", @habitation.matricula_imovel],
    ["Inscrição imobiliária", @habitation.inscricao_imobiliaria],
    ["Zona", @habitation.zona],
    ["Número prestações", @habitation.numero_prestacoes]
  ]

  intake_fields = [
    ["Origem da captação", @habitation.intake_origin],
    ["Status da captação", @habitation.intake_status.present? ? @habitation.intake_status_label : nil],
    ["Etapa atual", @habitation.intake_step],
    ["Grupo da captação", @habitation.intake_group_uuid],
    ["Modalidade", @habitation.intake_modalidade],
    ["Enviado para revisão", @habitation.submitted_for_review_at],
    ["Revisado em", @habitation.admin_reviewed_at],
    ["Revisado por", @habitation.admin_reviewed_by&.name],
    ["Notas da revisão", @habitation.admin_review_notes],
    ["Liberado pelo corretor", @habitation.broker_released_at],
    ["Escolha do fluxo de fotos", @habitation.photo_flow_choice],
    ["Sessão de fotos solicitada", @habitation.photo_session_requested_at],
    ["URL sessão de fotos", @habitation.photo_session_url]
  ]

  publication_fields = [
    ["Exibir no site", yes_no.call(@habitation.exibir_no_site_flag)],
    ["Exibir no site Salute", yes_no.call(@habitation.exibir_no_site_salute_flag)],
    ["Destaque web", yes_no.call(@habitation.destaque_web_flag)],
    ["Classificação das fotos", @habitation.foto_classificacao],
    ["Usar fotos empreendimento", yes_no.call(@habitation.use_development_photos_flag)],
    ["Publicar Zap", yes_no.call(@habitation.publicar_zapimoveis)],
    ["Publicar Viva Real", yes_no.call(@habitation.publicar_viva_real_vrsync)],
    ["Publicar Imovelweb", yes_no.call(@habitation.publicar_imovelweb)],
    ["Publicar Chaves na Mão", yes_no.call(@habitation.publicar_chaves_na_mao)],
    ["Publicar Casa Mineira", yes_no.call(@habitation.publicar_casa_mineira)],
    ["Publicar Lais AI", yes_no.call(@habitation.publicar_lais_ai)],
    ["Publicar Imovelweb 2", yes_no.call(@habitation.publicar_imovelweb_2)],
    ["Publicar Loft", yes_no.call(@habitation.publicar_loft)],
    ["Publicar Netimóveis 2", yes_no.call(@habitation.publicar_netimoveis_2)],
    ["Destaque Chaves na Mão", yes_no.call(@habitation.destaque_chaves_na_mao)],
    ["Período locação Chaves na Mão", @habitation.periodo_locacao_chaves_na_mao],
    ["Tipo publicação Viva Real", @habitation.tipo_publicacao_viva_real],
    ["Divulgar endereço Viva Real", yes_no.call(@habitation.divulgar_endereco_viva_real)],
    ["Modelo Casa Mineira", @habitation.modelo_casa_mineira],
    ["Tipo publicação Imovelweb", @habitation.tipo_publicacao_imovelweb],
    ["Mostrar mapa Imovelweb", yes_no.call(@habitation.mostrar_mapa_imovelweb)],
    ["Tipo publicação Imovelweb 2", @habitation.tipo_publicacao_imovelweb_2],
    ["Mostrar mapa Imovelweb 2", yes_no.call(@habitation.mostrar_mapa_imovelweb_2)],
    ["Meta title", @habitation.meta_title],
    ["Meta description", strip_tags(@habitation.meta_description.to_s).squish],
    ["Meta keywords", show_value.call(@habitation.meta_keywords)],
    ["Slug", @habitation.slug],
    ["Tour virtual", @habitation.tour_virtual],
    ["Podcast", @habitation.podcast_url]
  ]

  location_flags = [
    ["Terceira Avenida", @habitation.terceira_avenida_flag],
    ["Arriba", @habitation.arriba_flag],
    ["Avenida Brasil", @habitation.avenida_brasil_flag],
    ["Bairro Fazenda Itajaí", @habitation.bairro_fazenda_itajai_flag],
    ["Balneário Piçarras", @habitation.balneario_picarras_flag],
    ["Barra", @habitation.barra_flag],
    ["Barra Norte", @habitation.barra_norte_flag],
    ["Barra Sul", @habitation.barra_sul_flag],
    ["Cabeçudas", @habitation.cabecudas_flag],
    ["Camboriú", @habitation.camboriu_flag],
