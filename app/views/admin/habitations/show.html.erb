  internal_fields = [
    ["Captador", @habitation.primary_captador_name],
    ["Agenciador", @habitation.agenciador],
    ["Corretor Vista", @habitation.corretor_nome],
    ["Email corretor", @habitation.corretor_email],
    ["Telefone corretor", @habitation.corretor_telefone],
    ["Código corretor", @habitation.codigo_corretor],
