<% max_ct = rows.first&.ct || 1 %>
<% adm_column = local_assigns.fetch(:adm_column, false) %>
<% total_columns = adm_column ? 5 : 4 %>
<div class="table-responsive">
  <table class="table table-sm align-middle mb-0">
    <thead class="small text-muted text-uppercase">
      <tr>
        <th style="width: 40px;">Rank</th>
        <th>Corretor</th>
        <th style="min-width: 140px;">Captação <% if adm_column %><span class="text-muted">(Todos)</span><% end %></th>
        <% if adm_column %><th class="text-end" style="width: 90px;">Com ADM</th><% end %>
        <th class="text-end"><%= value_label %></th>
      </tr>
    </thead>
    <tbody>
      <% rows.each_with_index do |row, i| %>
        <tr class="capt-ranking-row">
          <td class="fw-bold text-muted"><%= i + 1 %></td>
          <td><%= row.name %></td>
          <td>
            <div class="bar-cell" style="width: 100%;">
              <div class="fill" style="width: <%= (row.ct.to_f / max_ct * 100).to_i %>%;"></div>
              <span class="label"><%= row.ct %></span>
            </div>
          </td>
          <% if adm_column %>
            <td class="text-end fw-semibold"><%= row.try(:adm_ct) || 0 %></td>
          <% end %>
          <td class="text-end fw-semibold">
            <%= number_to_currency(row.total_value.to_f, unit: "R$ ", precision: 0) %>
          </td>
        </tr>
      <% end %>
      <% if rows.empty? %>
        <tr><td colspan="<%= total_columns %>" class="text-center text-muted py-3"><i class="bi bi-inbox"></i> Sem dados no período.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
