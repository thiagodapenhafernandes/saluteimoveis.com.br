<%
  step_titles = {
    "intro"           => "Tipo de imóvel e modalidade",
    "proprietario"    => "Dados do proprietário",
    "endereco"        => "Endereço do imóvel",
    "caracteristicas" => "Características do imóvel",
    "negociacao"      => "Condições da negociação",
    "visitas"         => "Visitação e chaves",
    "fotos"           => "Fotos e autorização",
    "review"          => "Revisão final"
  }
  current_idx = Captacao::STEPS.index(@step)
  total_steps = @captacao.skip_visitas? ? Captacao::STEPS.size - 1 : Captacao::STEPS.size
  shown_idx   = @captacao.skip_visitas? && current_idx >= Captacao::STEPS.index("visitas") ? current_idx : current_idx
%>

<!-- Top bar com progress -->
<div class="wizard-top-bar">
  <div class="wizard-shell">
    <div class="d-flex align-items-center gap-2 mb-2">
      <%= link_to admin_captacoes_path, class: "btn btn-sm btn-link text-muted p-0 text-decoration-none" do %>
        <i class="bi bi-arrow-left"></i>
      <% end %>
      <div class="small text-muted flex-grow-1">
        Etapa <%= shown_idx + 1 %> de <%= total_steps %> · <strong class="text-dark"><%= step_titles[@step] %></strong>
      </div>
      <% if @captacao.draft? || !@captacao.completed %>
        <span class="badge bg-warning-subtle text-warning">Rascunho</span>
      <% end %>
    </div>
    <div class="wizard-progress">
      <div class="wizard-progress-bar" style="width: <%= @captacao.progress_percentage %>%;"></div>
    </div>
  </div>
</div>

<main class="wizard-shell wizard-content">
  <% if @captacao.errors.any? %>
    <div class="alert alert-danger border-0 shadow-sm">
      <strong><i class="bi bi-exclamation-triangle-fill me-1"></i>Corrija antes de continuar:</strong>
      <ul class="mb-0 mt-1 small">
        <% @captacao.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @captacao, url: admin_captacao_path(@captacao), method: :patch, multipart: true, local: true, html: { id: "wizard-form" } do |f| %>
    <%= hidden_field_tag :current_step, @step %>

    <%= render "admin/captacoes/steps/#{@step}", f: f %>

    <div class="wizard-bottom-nav">
      <div class="wizard-shell d-flex gap-2">
        <% if @captacao.previous_step %>
          <%= button_tag type: :submit, name: :direction, value: "back", class: "btn btn-outline-secondary flex-fill" do %>
            <i class="bi bi-arrow-left me-1"></i>Voltar
          <% end %>
        <% end %>
        <% if @step == "review" %>
          <%= button_tag type: :submit, name: :direction, value: "forward", class: "btn btn-success flex-fill" do %>
            <i class="bi bi-check-circle me-1"></i>Finalizar captação
          <% end %>
        <% else %>
          <%= button_tag type: :submit, name: :direction, value: "forward", class: "btn btn-primary flex-fill" do %>
            Avançar<i class="bi bi-arrow-right ms-1"></i>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</main>
