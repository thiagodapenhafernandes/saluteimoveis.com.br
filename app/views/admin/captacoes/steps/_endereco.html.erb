<h1 class="wizard-section-title"><i class="bi bi-geo-alt-fill text-primary me-2"></i>Endereço do imóvel</h1>
<p class="wizard-section-subtitle">Digite o CEP e nós preenchemos o endereço. Você só precisa completar com o número.</p>

<div data-controller="cep-lookup">
  <div class="wizard-field-group">
    <%= f.label :zip_code, "CEP", class: "form-label" %>
    <div class="input-group">
      <span class="input-group-text bg-white"><i class="bi bi-mailbox text-muted"></i></span>
      <%= f.text_field :zip_code,
                       class: "form-control",
                       placeholder: "88330-030",
                       maxlength: 9,
                       inputmode: "numeric",
                       data: { cep_lookup_target: "cep", action: "blur->cep-lookup#lookup" } %>
      <button type="button" class="btn btn-outline-primary" data-cep-lookup-target="button" data-action="cep-lookup#lookup">
        <i class="bi bi-search me-1"></i>Buscar
      </button>
    </div>
    <small data-cep-lookup-target="status" class="form-text text-muted">Toque em Buscar depois de digitar o CEP.</small>
  </div>

  <div class="row g-2">
    <div class="col-8">
      <div class="wizard-field-group">
        <%= f.label :street, "Rua / Avenida", class: "form-label" %>
        <span class="required-star">*</span>
        <%= f.text_field :street, class: "form-control", data: { cep_lookup_target: "address" } %>
      </div>
    </div>
    <div class="col-4">
      <div class="wizard-field-group">
        <%= f.label :street_number, "Número", class: "form-label" %>
        <span class="required-star">*</span>
        <%= f.text_field :street_number, class: "form-control", inputmode: "numeric", data: { cep_lookup_target: "number" } %>
      </div>
    </div>
  </div>

  <div class="row g-2">
    <div class="col-md-6">
      <div class="wizard-field-group">
        <%= f.label :neighborhood, "Bairro", class: "form-label" %>
        <%= f.text_field :neighborhood, class: "form-control", data: { cep_lookup_target: "neighborhood" } %>
      </div>
    </div>
    <div class="col-8 col-md-4">
      <div class="wizard-field-group">
        <%= f.label :city, "Cidade", class: "form-label" %>
        <span class="required-star">*</span>
        <%= f.text_field :city, class: "form-control", data: { cep_lookup_target: "city" } %>
      </div>
    </div>
    <div class="col-4 col-md-2">
      <div class="wizard-field-group">
        <%= f.label :state, "UF", class: "form-label" %>
        <%= f.text_field :state, class: "form-control text-uppercase", maxlength: 2, data: { cep_lookup_target: "uf" } %>
      </div>
    </div>
  </div>
</div>

<% unless @captacao.property_kind_terreno? %>
  <hr class="my-3">
  <div class="row g-2">
    <div class="col-md-8">
      <div class="wizard-field-group">
        <%= f.label :edificio_nome, "Edifício / Condomínio", class: "form-label" %>
        <%= f.text_field :edificio_nome, class: "form-control", placeholder: "Ex.: Edifício Mirante do Atlântico" %>
      </div>
    </div>
    <div class="col-md-4">
      <div class="wizard-field-group">
        <%= f.label :unidade_numero, "Unidade / Apto", class: "form-label" %>
        <%= f.text_field :unidade_numero, class: "form-control", placeholder: "1203" %>
      </div>
    </div>
  </div>
<% end %>
