<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1 text-gray-800">
      <i class="bi bi-shield-lock-fill text-danger me-2"></i>Trilha de auditoria
    </h1>
    <p class="text-muted small mb-0">Log append-only — qualquer UPDATE/DELETE é bloqueado pelo banco.</p>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0">
      <thead class="table-light small text-uppercase">
        <tr>
          <th>Quando</th>
          <th>Ação</th>
          <th>Corretor</th>
          <th>Ator</th>
          <th>Check-in</th>
          <th>IP</th>
          <th>Detalhes</th>
        </tr>
      </thead>
      <tbody>
        <% @logs.each do |log| %>
          <tr>
            <td class="small text-muted text-nowrap"><%= l(log.created_at, format: :short) %></td>
            <td>
              <% color = case log.action
                 when "created" then "primary"
                 when "closed" then "secondary"
                 when "forced_closed" then "warning"
                 when "flagged_suspicious" then "danger"
                 when "manual_request_approved" then "success"
                 when "manual_request_rejected" then "dark"
                 else "info"
                 end %>
              <span class="badge bg-<%= color %>"><%= log.action.humanize %></span>
            </td>
            <td class="small"><%= log.admin_user&.name || "—" %></td>
            <td class="small"><%= log.actor_admin_user&.name || "—" %></td>
            <td class="small"><%= log.check_in_id ? "##{log.check_in_id}" : "—" %></td>
            <td class="small text-muted"><%= log.ip %></td>
            <td class="small text-muted" style="max-width: 280px;">
              <code class="small"><%= log.metadata.to_json.truncate(100) %></code>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
