<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <h1 class="h3 mb-1">Editar SEO</h1>
      <p class="text-muted mb-0"><%= @seo_setting.page_name %></p>
    </div>
    <%= button_to generate_ai_admin_seo_setting_path(@seo_setting),
        method: :post,
        class: "btn btn-outline-primary",
        data: { turbo_submits_with: "Gerando com IA..." } do %>
      <i class="bi bi-stars me-1"></i>Gerar com IA
    <% end %>
  </div>

  <%= render "form", seo_setting: @seo_setting %>
</div>
