<%= form_with(model: [:admin, profile], local: true) do |f| %>
  <% if profile.errors.any? %>
    <div class="alert alert-danger shadow-sm border-0 mb-4">
      <h6 class="fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Ops! Verifique os erros abaixo:</h6>
      <ul class="mb-0 small">
        <% profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-4">
    <!-- Coluna Lateral: Dados Básicos -->
    <div class="col-lg-4">
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
          <h5 class="card-title mb-0 fw-bold"><i class="bi bi-shield-check me-2 text-primary"></i>Configuração Básica</h5>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <%= f.label :name, "Nome do Perfil", class: "form-label fw-bold small text-muted text-uppercase" %>
            <%= f.text_field :name, class: "form-control", placeholder: "Ex: Gerente de Vendas" %>
          </div>

          <div class="bg-light p-3 rounded-3 d-flex align-items-center mb-0">
             <div class="form-check form-switch mb-0">
               <%= f.check_box :active, class: "form-check-input", role: "switch" %>
               <%= f.label :active, "Perfil Ativo", class: "form-check-label fw-bold small" %>
             </div>
          </div>
        </div>
      </div>

      <div class="card shadow-sm border-0 bg-primary text-white">
        <div class="card-body p-4">
          <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-2"></i>Dica</h6>
          <p class="small mb-0 opacity-90">
            Perfis permitem delegar responsabilidades com segurança. O perfil <strong>Administrador</strong> já possui acesso total a tudo por padrão.
          </p>
        </div>
      </div>
    </div>

    <!-- Coluna Principal: Permissões -->
    <div class="col-lg-8">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h5 class="card-title mb-0 fw-bold"><i class="bi bi-key me-2 text-warning"></i>Permissões Granulares</h5>
          <span class="badge bg-light text-muted fw-normal border">Marque as funções permitidas</span>
        </div>
        <div class="card-body p-4">
          <% 
            modules = {
              "habitations" => { label: "Imóveis", icon: "house-door", actions: { "read" => "Visualizar", "create" => "Cadastrar", "update" => "Editar", "destroy" => "Excluir", "sync" => "Sincronizar CRM" } },
              "leads" => { label: "Leads", icon: "person-badge", actions: { "read" => "Visualizar", "manage" => "Gerenciar/Distribuir", "destroy" => "Excluir", "export" => "Exportar" } },
              "distribution_rules" => { label: "Regras de Distribuição", icon: "diagram-3", actions: { "manage" => "Gerenciar Regras" } },
              "settings" => { label: "Configurações", icon: "gear", actions: { "manage_website" => "Conteúdo Site", "manage_contact" => "Contatos", "manage_seo" => "SEO" } },
              "admin_users" => { label: "Administração", icon: "people", actions: { "manage" => "Gerenciar Usuários", "manage_profiles" => "Gerenciar Perfis" } }
            }
          %>

          <div class="accordion" id="permissionsAccordion">
            <% modules.each_with_index do |(mod, data), index| %>
              <div class="accordion-item border-0 mb-3 shadow-sm rounded-3 overflow-hidden">
                <h2 class="accordion-header">
                  <button class="accordion-button bg-light fw-bold text-dark <%= 'collapsed' if index > 0 %>" type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= mod %>">
                    <i class="bi bi-<%= data[:icon] %> me-3 text-primary"></i> <%= data[:label] %>
                  </button>
                </h2>
                <div id="collapse<%= mod %>" class="accordion-collapse collapse <%= 'show' if index == 0 %>">
                  <div class="accordion-body bg-white py-4">
                    <div class="row g-3">
                      <% data[:actions].each do |action, label| %>
                        <div class="col-md-6">
                          <div class="form-check position-relative p-2 bg-light rounded-3 px-3 d-flex align-items-center hover-shadow-sm transition-all">
                            <%= check_box_tag "profile[permissions][#{mod}][#{action}]", "true", profile.permissions&.dig(mod, action), class: "form-check-input mt-0 me-3" %>
                            <label class="form-check-label small fw-semibold stretched-link cursor-pointer" for="profile_permissions_<%= mod %>_<%= action %>">
                              <%= label %>
                            </label>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm border-0 mt-4 sticky-bottom" style="z-index: 100;">
    <div class="card-body d-flex justify-content-end gap-2 py-3">
      <%= link_to "Cancelar", admin_profiles_path, class: "btn btn-light border-0" %>
      <%= f.submit (profile.persisted? ? "Salvar Alterações" : "Criar Perfil"), class: "btn btn-primary px-5 fw-bold shadow-sm" %>
    </div>
  </div>
<% end %>

<style>
  .accordion-button:not(.collapsed) {
    background-color: #f8f9fa !important;
    color: #0d6efd !important;
    box-shadow: none !important;
  }
  .accordion-button::after {
    filter: grayscale(1);
  }
  .hover-shadow-sm:hover {
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    background-color: #f1f3f5 !important;
  }
  .transition-all {
    transition: all 0.2s ease-in-out;
  }
  .cursor-pointer {
    cursor: pointer;
  }
</style>
