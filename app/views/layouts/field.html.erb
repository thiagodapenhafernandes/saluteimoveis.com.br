<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title>Salute Imóveis — Campo</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0d6efd">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Salute Campo">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="manifest" href="<%= field_manifest_path(format: :json) %>">
    <link rel="apple-touch-icon" href="/field-icons/icon-192.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/field-icons/icon-192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/field-icons/icon-512.png">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/field-service-worker.js", { scope: "/field/" })
            .then(function (reg) { console.log("[field SW] registered, scope:", reg.scope); })
            .catch(function (err) { console.warn("[field SW] registration failed:", err); });
        });
      }
    </script>

    <style>
      html, body {
        background: #f8f9fa;
        min-height: 100vh;
        min-height: 100dvh;
      }
      .field-layout {
        max-width: 480px;
        margin: 0 auto;
        padding: 1rem;
        padding-bottom: 5rem;
      }
      .field-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        padding: 1.25rem;
      }
      .field-status-banner {
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        text-align: center;
      }
      .status-ok    { background: #d1e7dd; color: #0a3622; }
      .status-warn  { background: #fff3cd; color: #664d03; }
      .status-error { background: #f8d7da; color: #58151c; }
      .status-info  { background: #cff4fc; color: #055160; }
      .status-neutral { background: #e9ecef; color: #495057; }
      .big-action-btn {
        width: 100%;
        padding: 1.25rem;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 12px;
      }
    </style>
  </head>
  <body>
    <% flash.each do |type, msg| %>
      <% next if msg.blank? %>
      <div class="alert alert-<%= type == 'notice' ? 'info' : 'warning' %> mb-0" style="border-radius: 0;">
        <%= msg %>
      </div>
    <% end %>

    <div id="field-offline-banner" class="alert alert-warning mb-0 py-2 text-center small d-none" style="border-radius: 0;">
      <i class="bi bi-wifi-off me-1"></i>Você está offline — pings ficarão em fila.
    </div>

    <div id="field-install-banner" class="d-none position-fixed bottom-0 start-50 translate-middle-x bg-primary text-white shadow-lg rounded-3 p-3 mb-3 text-center" style="max-width: 360px; z-index: 1050;">
      <div class="fw-bold mb-1"><i class="bi bi-download me-1"></i>Instalar no celular</div>
      <small class="d-block mb-2 opacity-75">Use como app nativo — GPS em background funciona melhor.</small>
      <button id="field-install-btn" class="btn btn-light btn-sm fw-bold">Instalar</button>
      <button id="field-install-dismiss" class="btn btn-link btn-sm text-white opacity-75">Agora não</button>
    </div>

    <main class="field-layout">
      <%= yield %>
    </main>

    <script>
      // Banner de instalação (Chrome/Edge/Android)
      (function () {
        let deferredPrompt;
        window.addEventListener("beforeinstallprompt", function (e) {
          e.preventDefault();
          deferredPrompt = e;
          const banner = document.getElementById("field-install-banner");
          if (banner) banner.classList.remove("d-none");
        });
        const btn = document.getElementById("field-install-btn");
        if (btn) btn.addEventListener("click", function () {
          if (!deferredPrompt) return;
          deferredPrompt.prompt();
          deferredPrompt.userChoice.finally(function () {
            deferredPrompt = null;
            document.getElementById("field-install-banner").classList.add("d-none");
          });
        });
        const dismiss = document.getElementById("field-install-dismiss");
        if (dismiss) dismiss.addEventListener("click", function () {
          document.getElementById("field-install-banner").classList.add("d-none");
        });

        // Indicador offline
        function toggleOffline() {
          const banner = document.getElementById("field-offline-banner");
          if (!banner) return;
          if (navigator.onLine) banner.classList.add("d-none");
          else banner.classList.remove("d-none");
        }
        window.addEventListener("online", toggleOffline);
        window.addEventListener("offline", toggleOffline);
        toggleOffline();
      })();
    </script>
  </body>
</html>
