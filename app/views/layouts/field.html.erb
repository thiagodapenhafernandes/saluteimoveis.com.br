<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title>Salute Imóveis — Campo</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0d6efd">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Salute Campo">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="manifest" href="<%= field_manifest_path(format: :json) %>">
    <link rel="apple-touch-icon" href="/field-icons/icon-192.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/field-icons/icon-192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/field-icons/icon-512.png">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/field-service-worker.js", { scope: "/field/" })
            .then(function (reg) { console.log("[field SW] registered, scope:", reg.scope); })
            .catch(function (err) { console.warn("[field SW] registration failed:", err); });
        });
      }
    </script>

    <script type="module">
      // FingerprintJS open-source — hash estável por dispositivo/browser.
      // Usado como sinal de antifraude (detecção de fingerprint duplicado).
      import FingerprintJS from "https://openfpcdn.io/fingerprintjs/v4";
      (async function () {
        try {
          const fp = await FingerprintJS.load();
          const result = await fp.get();
          window.__fieldFingerprint = result.visitorId;
        } catch (e) {
          console.warn("[field fp] failed:", e);
        }
      })();
    </script>

    <style>
      html, body {
        background: #f8f9fa;
        min-height: 100vh;
        min-height: 100dvh;
      }
      .field-layout {
        max-width: 480px;
        margin: 0 auto;
        padding: 1rem;
        padding-bottom: 5rem;
      }
      .field-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        padding: 1.25rem;
      }
      .field-status-banner {
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        text-align: center;
      }
      .status-ok    { background: #d1e7dd; color: #0a3622; }
      .status-warn  { background: #fff3cd; color: #664d03; }
      .status-error { background: #f8d7da; color: #58151c; }
      .status-info  { background: #cff4fc; color: #055160; }
      .status-neutral { background: #e9ecef; color: #495057; }
      .big-action-btn {
        width: 100%;
        padding: 1.25rem;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 12px;
      }
    </style>
  </head>
  <body>
    <% flash.each do |type, msg| %>
      <% next if msg.blank? %>
      <div class="alert alert-<%= type == 'notice' ? 'info' : 'warning' %> mb-0" style="border-radius: 0;">
        <%= msg %>
      </div>
    <% end %>

    <div id="field-offline-banner" class="alert alert-warning mb-0 py-2 text-center small d-none" style="border-radius: 0;">
      <i class="bi bi-wifi-off me-1"></i>Você está offline — pings ficarão em fila.
    </div>

    <!-- Install Modal -->
    <div id="field-install-overlay" class="d-none position-fixed top-0 start-0 w-100 h-100" style="background: rgba(15, 23, 42, .75); z-index: 1060; backdrop-filter: blur(4px);">
      <div class="position-absolute top-50 start-50 translate-middle bg-white rounded-4 shadow-lg p-4" style="max-width: 420px; width: 92%;">
        <div class="text-center mb-3">
          <div class="bg-primary bg-opacity-10 rounded-4 d-inline-flex align-items-center justify-content-center" style="width: 72px; height: 72px;">
            <i class="bi bi-phone text-primary" style="font-size: 2.2rem;"></i>
          </div>
          <h4 class="fw-bold mt-3 mb-1">Instale o app Salute Campo</h4>
          <p class="text-muted small mb-0">Experiência mais rápida, notificações e acesso offline.</p>
        </div>

        <!-- Android/Chrome: usa beforeinstallprompt -->
        <div id="field-install-android" class="d-none">
          <ul class="small text-muted mb-3 ps-3">
            <li>Abre como app, sem barra de endereço</li>
            <li>GPS em background funciona melhor</li>
            <li>Pings continuam quando app fica escondido</li>
          </ul>
          <button id="field-install-btn" class="btn btn-primary w-100 fw-bold py-2 mb-2">
            <i class="bi bi-download me-1"></i>Instalar agora
          </button>
        </div>

        <!-- iOS: instruções manuais -->
        <div id="field-install-ios" class="d-none">
          <ol class="small text-muted mb-3 ps-3">
            <li>Toque no ícone <i class="bi bi-box-arrow-up text-primary"></i> <strong>Compartilhar</strong> na barra do Safari</li>
            <li>Escolha <strong>"Adicionar à Tela de Início"</strong></li>
            <li>Confirme em "Adicionar"</li>
          </ol>
        </div>

        <!-- Fallback (navegador desconhecido) -->
        <div id="field-install-fallback" class="d-none">
          <p class="small text-muted">
            Abra este site no Chrome (Android) ou Safari (iPhone) e procure pela opção
            "Instalar app" ou "Adicionar à Tela de Início" no menu do navegador.
          </p>
        </div>

        <button id="field-install-dismiss" class="btn btn-link w-100 text-muted small">
          Continuar no navegador por enquanto
        </button>
      </div>
    </div>

    <main class="field-layout">
      <%= yield %>
    </main>

    <script>
      (function () {
        const DISMISS_KEY = "field_install_dismissed_until";
        const overlay   = document.getElementById("field-install-overlay");
        const androidBox = document.getElementById("field-install-android");
        const iosBox    = document.getElementById("field-install-ios");
        const fallback  = document.getElementById("field-install-fallback");
        const installBtn = document.getElementById("field-install-btn");
        const dismissBtn = document.getElementById("field-install-dismiss");

        // Já está instalado? display-mode: standalone é sinal de que rodou como PWA.
        function isStandalone() {
          return window.matchMedia("(display-mode: standalone)").matches
              || window.navigator.standalone === true;
        }

        function isIos() {
          return /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
        }

        function shouldShow() {
          if (isStandalone()) return false;
          const until = parseInt(localStorage.getItem(DISMISS_KEY) || "0", 10);
          if (until && Date.now() < until) return false;
          return true;
        }

        function showOverlay(mode) {
          if (!shouldShow()) return;
          androidBox.classList.add("d-none");
          iosBox.classList.add("d-none");
          fallback.classList.add("d-none");
          if (mode === "android") androidBox.classList.remove("d-none");
          else if (mode === "ios") iosBox.classList.remove("d-none");
          else fallback.classList.remove("d-none");
          overlay.classList.remove("d-none");
        }

        let deferredPrompt;
        window.addEventListener("beforeinstallprompt", function (e) {
          e.preventDefault();
          deferredPrompt = e;
          showOverlay("android");
        });

        // iOS não suporta beforeinstallprompt → mostra instruções após 800ms
        if (isIos() && shouldShow()) {
          setTimeout(() => showOverlay("ios"), 800);
        }

        if (installBtn) {
          installBtn.addEventListener("click", function () {
            if (!deferredPrompt) return;
            deferredPrompt.prompt();
            deferredPrompt.userChoice.finally(function () {
              deferredPrompt = null;
              overlay.classList.add("d-none");
            });
          });
        }

        if (dismissBtn) {
          dismissBtn.addEventListener("click", function () {
            // Esconde por 7 dias
            localStorage.setItem(DISMISS_KEY, (Date.now() + 7 * 24 * 60 * 60 * 1000).toString());
            overlay.classList.add("d-none");
          });
        }

        // Indicador offline
        function toggleOffline() {
          const banner = document.getElementById("field-offline-banner");
          if (!banner) return;
          if (navigator.onLine) banner.classList.add("d-none");
          else banner.classList.remove("d-none");
        }
        window.addEventListener("online", toggleOffline);
        window.addEventListener("offline", toggleOffline);
        toggleOffline();
      })();
    </script>
  </body>
</html>
