<% return unless current_admin_user.present? %>

<div class="fixed bottom-5 right-5 z-50">
  <div class="rounded-2xl border border-gray-200 bg-white/95 backdrop-blur px-3 py-2 shadow-lg">
    <div class="flex items-center gap-2 text-xs text-gray-600 mb-2">
      <i class="bi bi-person-badge"></i>
      <span class="font-semibold text-gray-700 truncate max-w-[140px]"><%= current_admin_user.name %></span>
    </div>
    <div class="flex justify-end">
      <%= render "shared/broker_share_menu", property: property %>
    </div>
  </div>
</div>
